rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isProjectMember() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/team_members/$(request.auth.uid));
    }
    
    function isProjectOwner() {
      return isAuthenticated() && 
             request.auth.uid in resource.data.ownerIds;
    }
    
    function canAccessTeamMemberData(memberId) {
      return isAuthenticated() && 
             (request.auth.uid == memberId || isProjectMember());
    }

    // Project info - only authenticated project members can read
    match /project/info {
      allow read: if isProjectMember();
      allow write: if false; // Project info should be managed by backend/admin
    }

    // Tasks collection - only project members can read/write
    match /tasks/{status} {
      allow read, write: if isProjectMember();
    }

    // Team members - only authenticated users can read
    // Users can only write their own member document
    match /team_members/{memberId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == memberId;
      allow create: if isAuthenticated() && request.auth.uid == memberId;
    }

    // Calendar events - users can only access their own calendar
    // Project members can read other team members' calendars for scheduling
    match /calendar/{memberId} {
      allow read: if canAccessTeamMemberData(memberId);
      allow write: if isAuthenticated() && request.auth.uid == memberId;
      allow create: if isAuthenticated() && request.auth.uid == memberId;
    }

    // Chat messages - users can only access their own chat
    match /chats/{userId}/{document=**} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}